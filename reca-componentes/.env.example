# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reca_ecommerce"

# Redis (opcional em dev — há fallback em memória)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="super-secret-key-min-32-chars-change-me-please"
JWT_REFRESH_SECRET="another-super-secret-key-change-me-please"

# Mercado Pago
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="..."

# Resend (e-mail)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@recacomponentes.com.br"

# Storage (imagens) — Cloudflare R2 ou AWS S3
# Deixe em branco para usar armazenamento local (/public/uploads) em dev.
S3_BUCKET="reca-produtos"
S3_REGION="auto"
S3_ENDPOINT="https://....r2.cloudflarestorage.com"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."
# URL pública base do bucket (R2: https://pub-xxxx.r2.dev ou domínio próprio)
S3_PUBLIC_URL="https://pub-xxxx.r2.dev"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
NEXT_PUBLIC_STORE_NAME="RECA Componentes"
NEXT_PUBLIC_STORE_CNPJ="00.000.000/0001-00"
NEXT_PUBLIC_STORE_CITY="Portão - RS"
NODE_ENV="development"

# Admin: apenas estes e-mails podem administrar a loja (separados por vírgula)
ADMIN_EMAILS="egnportao@gmail.com"

# Login com Google (OAuth) — crie no Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"
