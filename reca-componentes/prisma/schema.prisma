// Prisma schema — RECA Componentes
// Banco: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String         @id @default(cuid())
  email           String         @unique
  nomeCompleto    String
  cpf             String         @unique
  telefone        String
  dataNasc        DateTime
  role            Role           @default(CLIENTE)
  emailVerificado Boolean        @default(false)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  enderecos       Endereco[]
  pedidos         Pedido[]
  sessoes         Sessao[]
  otps            OtpCode[]
  dadosFiscais    DadosFiscais[]
}

model OtpCode {
  id         String   @id @default(cuid())
  email      String
  codigoHash String // bcrypt do OTP
  expiraEm   DateTime
  usado      Boolean  @default(false)
  tentativas Int      @default(0)
  criadoEm   DateTime @default(now())
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId  String?

  @@index([email])
}

model Sessao {
  id           String   @id @default(cuid())
  usuarioId    String
  refreshToken String   @unique // hash
  expiraEm     DateTime
  userAgent    String?
  ip           String?
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
}

model Endereco {
  id          String   @id @default(cuid())
  usuarioId   String
  apelido     String
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  principal   Boolean  @default(false)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos     Pedido[]
}

model DadosFiscais {
  id          String     @id @default(cuid())
  usuarioId   String
  tipo        TipoFiscal // PF ou PJ
  cpf         String?
  cnpj        String?
  razaoSocial String?
  ie          String?
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])
}

model Categoria {
  id       String    @id @default(cuid())
  nome     String    @unique
  slug     String    @unique
  icone    String?
  produtos Produto[]
}

model Tag {
  id       String       @id @default(cuid())
  nome     String       @unique
  slug     String       @unique
  produtos ProdutoTag[]
}

model Produto {
  id                String         @id @default(cuid())
  nome              String
  slug              String         @unique
  sku               String         @unique
  descricaoInformal String
  descricaoTecnica  String
  especificacoes    Json // objeto chave-valor das specs
  preco             Decimal        @db.Decimal(10, 2)
  precoOriginal     Decimal?       @db.Decimal(10, 2)
  estoque           Int            @default(0)
  imagens           String[]
  datasheetUrl      String?
  recursosUrls      Json?
  pesoGramas        Int?
  dimensoesCm       Json?
  ativo             Boolean        @default(true)
  destaque          Boolean        @default(false)
  freteGratis       Boolean        @default(false)
  categoriaId       String
  categoria         Categoria      @relation(fields: [categoriaId], references: [id])
  tags              ProdutoTag[]
  itensPedido       ItemPedido[]
  avisosEstoque     AvisoEstoque[]
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt
}

model ProdutoTag {
  produtoId String
  tagId     String
  produto   Produto @relation(fields: [produtoId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([produtoId, tagId])
}

model Pedido {
  id              String       @id @default(cuid())
  numero          String       @unique // ex: "RECA-2026-001234"
  usuarioId       String
  enderecoId      String
  status          StatusPedido @default(AGUARDANDO_PAGAMENTO)
  subtotal        Decimal      @db.Decimal(10, 2)
  frete           Decimal      @db.Decimal(10, 2)
  desconto        Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  modalidadeFrete String
  rastreamento    String?
  mpPaymentId     String?
  mpStatus        String?
  cupomCodigo     String?
  notaFiscalUrl   String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])
  endereco        Endereco     @relation(fields: [enderecoId], references: [id])
  itens           ItemPedido[]
  pagamentos      Pagamento[]
}

model ItemPedido {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String
  nome       String // snapshot do nome no momento da compra
  preco      Decimal @db.Decimal(10, 2)
  quantidade Int
  subtotal   Decimal @db.Decimal(10, 2)
  pedido     Pedido  @relation(fields: [pedidoId], references: [id])
  produto    Produto @relation(fields: [produtoId], references: [id])
}

model Pagamento {
  id          String          @id @default(cuid())
  pedidoId    String
  mpPaymentId String          @unique
  metodo      MetodoPagamento
  status      StatusPagamento
  valor       Decimal         @db.Decimal(10, 2)
  detalhes    Json?
  criadoEm    DateTime        @default(now())
  pedido      Pedido          @relation(fields: [pedidoId], references: [id])
}

model Cupom {
  id       String    @id @default(cuid())
  codigo   String    @unique
  tipo     TipoCupom // PERCENTUAL ou FIXO
  valor    Decimal   @db.Decimal(10, 2)
  minimo   Decimal?  @db.Decimal(10, 2)
  usos     Int       @default(0)
  maxUsos  Int?
  expiraEm DateTime?
  ativo    Boolean   @default(true)
}

model AvisoEstoque {
  id        String   @id @default(cuid())
  produtoId String
  email     String
  criadoEm  DateTime @default(now())
  produto   Produto  @relation(fields: [produtoId], references: [id])

  @@unique([produtoId, email])
}

enum Role {
  CLIENTE
  ADMIN
}

enum TipoFiscal {
  PF
  PJ
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_CONFIRMADO
  EM_SEPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
  ESTORNADO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

enum MetodoPagamento {
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
}

enum TipoCupom {
  PERCENTUAL
  FIXO
}

/// Configuração da loja (linha única, id = "default"). Gerenciada pelo admin.
model Configuracao {
  id                String   @id @default("default")
  nomeLoja          String   @default("RECA Componentes")
  freteGratisAtivo  Boolean  @default(true)
  freteGratisMinimo Decimal  @default(299) @db.Decimal(10, 2)
  descontoGlobalPct Decimal  @default(0) @db.Decimal(5, 2)
  bannerTexto       String?
  atualizadoEm      DateTime @updatedAt @default(now())
}
