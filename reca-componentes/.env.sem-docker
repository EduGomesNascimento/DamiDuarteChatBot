# Configuração para rodar LOCAL sem Docker (banco PostgreSQL embutido + cache em memória).
# O iniciar-loja-sem-docker.bat copia este arquivo para .env automaticamente.

# Banco embutido (scripts/db-local.mjs) — usuário/senha/porta fixos
DATABASE_URL="postgresql://user:password@localhost:5432/reca_ecommerce"

# Sem Redis: deixando vazio, o app usa cache em memória automaticamente
REDIS_URL=

# Segredos de desenvolvimento (troque em produção)
JWT_SECRET="dev-local-secret-min-32-chars-troque-em-prod"
JWT_REFRESH_SECRET="dev-local-refresh-secret-32-chars-troque-prod"

# E-mail: sem RESEND_API_KEY, o código OTP aparece no console (janela SERVIDOR)
EMAIL_FROM="noreply@recacomponentes.com.br"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="RECA Componentes"
NEXT_PUBLIC_STORE_CNPJ="00.000.000/0001-00"
NEXT_PUBLIC_STORE_CITY="Portão - RS"
NODE_ENV="development"

# Admin: apenas estes e-mails podem administrar a loja (separados por vírgula)
ADMIN_EMAILS="egnportao@gmail.com"

# Login com Google (OAuth) — crie no Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"
