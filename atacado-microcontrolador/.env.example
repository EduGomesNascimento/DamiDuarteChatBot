# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aen_ecommerce"

# Redis (opcional em dev — há fallback em memória)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="super-secret-key-min-32-chars-change-me-please"
JWT_REFRESH_SECRET="another-super-secret-key-change-me-please"

# Mercado Pago
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="..."

# Resend (e-mail)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@atacadomicro.com.br"

# Storage (imagens) — Cloudflare R2 ou AWS S3
S3_BUCKET="aen-produtos"
S3_REGION="auto"
S3_ENDPOINT="https://....r2.cloudflarestorage.com"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
NEXT_PUBLIC_STORE_NAME="Atacado do Microcontrolador"
NEXT_PUBLIC_STORE_CNPJ="00.000.000/0001-00"
NEXT_PUBLIC_STORE_CITY="Portão - RS"
NODE_ENV="development"
